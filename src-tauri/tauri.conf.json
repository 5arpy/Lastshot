{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lastshot",
  "version": "1.9.1",
  "identifier": "dev.lastshot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lastshot – Instant Replay & Snipping",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#15161b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/Lastshot/**",
          "$HOME/Videos/Lastshot/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Free instant replay & snipping tool for Windows",
    "longDescription": "Lastshot keeps the last seconds of your screen in a GPU-encoded memory buffer and saves them as an MP4 when you press a hotkey. It also has a snipping tool with quick markup, and can shrink clips to fit Discord. No account, no telemetry, no uploads. Based on ClipFlow by jaimitus and drexjgobgt."
  }
}
